{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": false,
    "declaration": true,
    // NOT "dist": that is Vite's build output directory, so `npm run
    // lint:types` dropped tsconfig.node.tsbuildinfo into the deployable
    // bundle. Harmless today only because `npm run build` runs Vite alone and
    // Vite empties dist/ first — adding a typecheck to the build, the obvious
    // next CI step, would have started emitting compiled middleware.js and
    // api/*.js into the deploy alongside it.
    "outDir": "node_modules/.tmp/tsconfig-node",
    // middleware.ts runs on Vercel's Edge runtime: web-standard APIs
    // (Request/Response/fetch/AbortController) plus process.env. DOM gives us
    // the former; @types/node (already a devDependency) gives us the latter.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022"
  },
  // middleware.ts and api/ are production code — the OG tags every social
  // crawler sees, and the sitemap every search crawler reads — but middleware
  // was once covered by neither tsconfig, so `npm run lint:types` never
  // checked it. Deno edge functions stay out: they import via `jsr:` and
  // `https://esm.sh/...` specifiers that tsc cannot resolve. They are checked
  // by `npm run lint:edge` instead.
  "include": ["vite.config.ts", "middleware.ts", "api/**/*"]
}
