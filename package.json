  "version": "1.0.0",
  "description": "Visual storytelling platform about Romania — culture, history, traditions, and hidden gems.",
  "author": "The RoStory",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
